{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "agentero-library",
  "version": "0.1.0",
  "description": "在 Codex 对话旁管理本地文献、阅读 PDF 并整理研究笔记。",
  "author": {
    "name": "doomclouds"
  },
  "homepage": "https://github.com/doomclouds/CodexWorkbench",
  "repository": "https://github.com/doomclouds/CodexWorkbench",
  "license": "MIT",
  "keywords": ["research", "papers", "notes", "agentero", "codex"],
  "extensions": {
    "com.openai": {
      "onboardingSkill": "./skills/library-setup/SKILL.md",
      "interface": {
        "displayName": "文献库",
        "shortDescription": "本地文献、PDF 阅读与研究笔记",
        "longDescription": "连接用户安装的 Agentero CLI，在 Codex 对话旁检索本地文献、阅读论文并维护研究笔记。通过插件设置配置 CLI 与 Vault，按需启用 PDF 正文读取。",
        "developerName": "doomclouds",
        "category": "Productivity",
        "capabilities": ["Interactive"],
        "defaultPrompt": "打开文献库，检查本机连接并继续阅读。",
        "composerIcon": "./assets/icon.png",
        "logo": "./assets/icon.png"
      }
    }
  }
}
