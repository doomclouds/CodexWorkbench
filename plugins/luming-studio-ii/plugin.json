{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "luming-studio-ii",
  "version": "1.0.3",
  "description": "面向共享白板、架构图解与 Agent 协作的 Luming Studio II。",
  "author": {
    "name": "doomclouds"
  },
  "license": "MIT",
  "homepage": "https://github.com/doomclouds/CodexWorkbench",
  "repository": "https://github.com/doomclouds/CodexWorkbench",
  "keywords": [
    "whiteboard",
    "design",
    "collaboration",
    "luming",
    "codex"
  ],
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "interface": {
        "displayName": "鹿鸣 · Luming Studio II",
        "shortDescription": "共享白板、图解与 Agent 协作",
        "longDescription": "在 Codex 对话旁编辑共享白板，整理流程图、HTML 图解、文档和待办。通过具体备注附加上下文，审阅 Agent 建议，查看历史并导出作品。",
        "developerName": "doomclouds",
        "category": "Productivity",
        "capabilities": ["Interactive"],
        "defaultPrompt": "查看当前白板并整理修改建议。",
        "composerIcon": "./assets/icon.png",
        "logo": "./assets/icon.png"
      }
    }
  }
}
