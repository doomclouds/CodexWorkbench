{
  "name": "@codexworkbench/luming-studio-ii-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Luming Studio II Web frontend",
  "license": "MIT",
  "exports": {
    "./ui/base": "./src/ui/base/index.ts",
    "./ui/domain/canvas": "./src/ui/domain/canvas/index.ts"
  },
  "scripts": {
    "lint": "eslint --max-warnings 0 src tests lint eslint.config.mjs vite.config.ts vitest.config.mts && oxlint --deny-warnings src tests vite.config.ts vitest.config.mts && oxfmt --check src tests lint eslint.config.mjs vite.config.ts vitest.config.mts && node ../../../../tooling/studio-lint/check-markup.mjs",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck",
    "test": "node --test tests/contracts/base-lint.test.mjs tests/contracts/canvas-lint.test.mjs && vitest run",
    "preview:canvas": "vite --host 127.0.0.1",
    "build": "pnpm check && pnpm test && vite build"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@babel/eslint-parser": "8.1.2",
    "@stylistic/eslint-plugin": "6.0.1",
    "@types/node": "24.12.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "29.0.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
