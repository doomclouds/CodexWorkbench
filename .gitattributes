* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.wasm binary

# Generated bundles preserve whitespace in upstream strings and PDF fixtures.
plugins/*/runtime/** linguist-generated=true -whitespace
plugins/*/assets/licenses/packages/** -text -whitespace linguist-vendored=true
plugins/*/assets/licenses/sources/** -text -whitespace linguist-vendored=true
plugins/*/assets/licenses/THIRD_PARTY_LICENSES.txt -text -whitespace linguist-generated=true
